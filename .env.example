# Database
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Auth
AUTH_SECRET=your-secret-here

# AI
OPENROUTER_API_KEY=
NEXT_PUBLIC_DEFAULT_MODEL=anthropic/claude-opus-4-8

# Model overrides (optional — defaults to default model)
CONTEXT_MODEL=
MEMORY_MODEL=
ORGANIZE_MODEL=
TITLE_MODEL=

# Code execution (optional — enables E2B sandbox)
E2B_API_KEY=

# Web search (optional — enables Tavily search tool)
TAVILY_API_KEY=
SEARCH_COST_USD=0.01

# Email (Mailtrap)
MAILTRAP_API_KEY=

# Payments (ZPay / Alipay)
ZPAY_GATEWAY=
ZPAY_PID=
ZPAY_KEY=
ZPAY_CHANNEL_ID=

# App
NEXT_PUBLIC_APP_NAME=z1.chat
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USD_TO_CNY=7.2
FREE_CREDITS_CNY=0
COST_MARKUP=1

# Context window
MAX_CONTEXT_TOKENS=

# Dev
DEV_BYPASS_AUTH=false

# Puppeteer (optional — for website preview)
CHROMIUM_PATH=
